# ============================================================
# FraudShield AI — Environment Variables
# ============================================================

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraudshield
DB_USER=root
DB_PASSWORD=your_mysql_password

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=fraudshield_ai_secret_key_32chars_secure_2024
APP_DEBUG=true

# --- Model ---
MODEL_PATH=models/best_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib
MODEL_VERSION=1.0.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/fraudshield.log
